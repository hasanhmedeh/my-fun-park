// Accounts, tickets and ride rounds for The Funfair.
// After editing: `pnpm db:migrate --name <change>` to write a migration, then `pnpm db:generate`.
// Ticket prices and each attraction's open/maintenance switch (attraction_settings), the pack
// size, purchase cooldown, park-wide open/closed switch and private access (park_settings, with
// allowed_ips) are rows, edited in The Ringmaster's Office (/ringmaster) or Prisma Studio.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (read from DATABASE_URL).
datasource db {
  provider = "postgresql"
}

/// Everything that takes a ticket: the rides and the games. Mirrors the zone ids in apps/web/src/world/layout.ts.
/// plot1 to plot8 are Creators' Valley's plots: each runs whichever player-built coaster staff have
/// released onto it (see Creation), and is priced and closed like any other attraction.
/// flight is Funfair Air's flight from the airport to Palm Cay (and back): one round is one flight,
/// gate to gate. jetski, slides, cannons and volley are Palm Cay's beach park attractions.
enum Attraction {
  coaster
  falcon
  rocket
  ferris
  flip
  ship
  speedway
  trail
  drone
  crates
  striker
  ducks
  plot1
  plot2
  plot3
  plot4
  plot5
  plot6
  plot7
  plot8
  flight
  jetski
  slides
  cannons
  volley

  @@map("attraction")
}

/// What an account may do. Admins ("staff") get The Ringmaster's Office (/ringmaster) and can still
/// board and buy while the park is closed. Appointed with `pnpm staff:appoint <email>`.
enum Role {
  player
  admin

  @@map("role")
}

/// What a member said they are, at signup (or when asked after logging in).
enum Gender {
  female
  male
  other
  prefer_not_to_say

  @@map("gender")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  /// Display spelling, as typed at signup.
  username         String
  /// Lowercased username, so "Hasan" and "hasan" can't both exist.
  usernameKey      String             @unique @map("username_key")
  /// Null for accounts made with Google, which sign in there.
  passwordHash     String?            @map("password_hash")
  /// The Google account's id ("sub"), once the member has continued with Google.
  googleId         String?            @unique @map("google_id")
  /// Null for accounts created before signup asked for it: they're asked after logging in.
  gender           Gender?
  /// Tickets left to spend. Never negative (a CHECK constraint backs that up).
  ticketBalance    Int                @default(0) @map("ticket_balance")
  /// When the last pack was bought. The next one is allowed park_settings.cooldown_hours later.
  lastPurchaseAt   DateTime?          @map("last_purchase_at")
  /// When the user accepted the Terms of Service and Privacy Policy, and which version.
  /// Null for accounts created before signup asked for it.
  termsAcceptedAt  DateTime?          @map("terms_accepted_at")
  termsVersion     String?            @map("terms_version")
  role             Role               @default(player)
  /// When the member took their free Coaster Workshop starter kit (once only). Null until then.
  starterKitAt     DateTime?          @map("starter_kit_at")
  /// Saved coaster designs bought beyond the free ones (src/workshop/design.ts). Not on sale yet.
  extraDesignSlots Int                @default(0) @map("extra_design_slots")
  /// The visitor's look from the game's customiser: which person they play, their outfit's colours,
  /// height and build (checked by src/auth/visitor-look.ts). Null until they save one.
  visitorLook      Json?              @map("visitor_look")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  purchases        TicketPurchase[]
  rounds           RideRound[]
  adminActions     AdminAction[]
  shopOrders       ShopOrder[]
  souvenirs        Souvenir[]
  suggestions      Suggestion[]       @relation("SuggestionAuthor")
  trailRuns        TrailRun[]
  /// Staff only: the suggestions they answered.
  repliedTo        Suggestion[]       @relation("SuggestionReplier")
  coasterParts     CoasterParts[]
  partOrders       CoasterPartOrder[]
  designs          CoasterDesign[]
  creations        Creation[]         @relation("CreationCreator")
  /// Staff only: the coasters they released or declined.
  reviewed         Creation[]         @relation("CreationReviewer")

  @@index([createdAt])
  @@map("users")
}

/// One pack of tickets bought. Free for now (price 0, provider "free"), but recorded like a sale
/// so real payments can slot in later.
model TicketPurchase {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity     Int
  priceCents   Int      @map("price_cents")
  currency     String
  provider     String
  /// The user's ticket balance right after this purchase.
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ticket_purchases")
}

/// Each attraction's price and whether it is running. The migrations seed every attraction; edit a
/// row (in The Ringmaster's Office, or e.g. with `pnpm studio:prod`) to change a price or close a
/// ride for maintenance without a deploy. Rounds keep what they cost at the time in
/// ride_rounds.tickets_spent. An attraction without a row costs its default (rides/attractions.ts).
model AttractionSettings {
  attraction    Attraction @id
  /// Tickets per round, at least 1 (a CHECK constraint in the migration).
  tickets       Int
  /// False while it is closed for maintenance: the game shows it under maintenance and boarding
  /// stops (staff can still board, to test it).
  open          Boolean    @default(true)
  /// Shown to visitors while it is closed, e.g. "New brakes going in, back tomorrow".
  closedMessage String?    @map("closed_message")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  @@map("attraction_settings")
}

/// The park's switches, in a single row (id 1, enforced by a CHECK in the migration). Edit it, e.g.
/// with `pnpm studio:prod`, to close the park without a deploy: the game shows the closed sign,
/// and boarding and ticket sales stop (staff can still do both). Accounts keep working.
/// Without the row the API treats the park as open, with the column defaults below.
model ParkSettings {
  id                 Int      @id @default(1)
  open               Boolean  @default(true)
  /// Shown to visitors while the park is closed, e.g. "Closed for maintenance, back at 18:00".
  closedMessage      String?  @map("closed_message")
  /// Stricter than closed: nobody but staff can come into the fair at all, and visitors already in
  /// it are sent out (their round, if any, refunded). Accounts keep working, so staff can log in.
  underMaintenance   Boolean  @default(false) @map("under_maintenance")
  /// Shown to visitors while the park is under maintenance, e.g. "Repainting the midway, back at 18:00".
  maintenanceMessage String?  @map("maintenance_message")
  /// Tickets in one pack, 1 to 1000 (a CHECK constraint in the migration).
  packSize           Int      @default(20) @map("pack_size")
  /// Hours between two purchases, counted from the last one: 0 (no wait) to 168 (a CHECK constraint).
  cooldownHours      Int      @default(5) @map("cooldown_hours")
  /// The most tickets a free pack tops a balance up to, 1 to 100000 (a CHECK constraint): with 45,
  /// a member holding 40 gets 5, one holding 45 or more gets none. Null means no ceiling.
  ticketCap          Int?     @map("ticket_cap")
  /// Private access: only the addresses in allowed_ips can reach the site at all (the pages, the
  /// API, staff included). Locked out? Switch it off here with `pnpm studio:prod`.
  allowlistOnly      Boolean  @default(false) @map("allowlist_only")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("park_settings")
}

/// One paid go on one attraction: tickets are spent when it starts. It is open until the game
/// reports the result (endedAt, completed, stats), or until the user boards something else,
/// which closes it as abandoned (completed false, no stats).
model RideRound {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride         Attraction
  ticketsSpent Int        @map("tickets_spent")
  startedAt    DateTime   @default(now()) @map("started_at")
  endedAt      DateTime?  @map("ended_at")
  completed    Boolean    @default(false)
  /// What the game measured, e.g. { "topSpeedKmh": 92.4, "maxG": 3.1 }: a flat object of numbers,
  /// client-reported, so informational only.
  stats        Json?
  /// A Rally Trail round that crossed the line: its run on the daily leaderboard.
  trailRun     TrailRun?
  /// On a Creators' Valley plot: the player-built coaster it ran then (null once that's deleted).
  creationId   String?    @map("creation_id")
  creation     Creation?  @relation(fields: [creationId], references: [id], onDelete: SetNull)
  /// Tickets paid to that coaster's creator for this round (0 on their own rides). Kept when the
  /// round is refunded.
  royalty      Int        @default(0)

  @@index([userId, ride])
  @@index([userId, endedAt])
  @@index([startedAt])
  @@map("ride_rounds")
}

/// The Ringmaster's Office logbook: one row per change made by staff (or by `pnpm staff:*`).
model AdminAction {
  id        String   @id @default(cuid())
  /// Who did it. Set to null when that account is deleted; actorName still says who it was.
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// The actor's username at the time, or "cli" for the staff scripts.
  actorName String   @map("actor_name")
  /// What happened: park.open, park.close, park.maintenance.on, park.maintenance.off, settings.update,
  /// access.on, access.off, access.ip.add, access.ip.remove, attraction.open, attraction.close,
  /// price.update, attraction.update, shop.price, shop.stock, shop.update, user.tickets, user.role,
  /// user.cooldown, user.delete, suggestion.reply, suggestion.status, trail.disqualify, trail.reinstate,
  /// creation.release, creation.decline, creation.remove, workshop.price, workshop.stock or workshop.update.
  action    String
  /// What it happened to: an attraction id, a shop item id, a coaster part, an allowed address or a
  /// user's email (for a suggestion, its author's; for a Rally Trail run, its driver's; for a coaster,
  /// its creator's). Null for the park's settings.
  target    String?
  /// Before and after, e.g. { "before": { "tickets": 5 }, "after": { "tickets": 3 } }.
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_actions")
}

/// The addresses that can reach the site while park_settings.allowlist_only is on. The member of
/// staff who switches it on is added automatically. Matched in src/access/allowlist.ts.
model AllowedIp {
  id        String   @id @default(cuid())
  /// An address ("203.0.113.7") or a range in CIDR notation ("2001:db8:1:2::/64").
  ip        String   @unique
  /// Whose it is, e.g. "Hasan at home". Up to 60 characters.
  label     String?
  /// The username of the member of staff who added it, or "cli".
  addedBy   String   @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_ips")
}

/// Who's in the fair right now: one row per open game tab (its own random id), written by the live
/// stream (GET /api/live) while it's connected and counted in The Ringmaster's Office. Rows not seen
/// for a minute don't count, and are cleared out after ten. No foreign key: it's only presence.
model LiveVisitor {
  id     String   @id
  /// The member in that tab, or null for a guest.
  userId String?  @map("user_id")
  /// Past the entrance (the intro card), rather than looking at it.
  inFair Boolean  @map("in_fair")
  /// The connection that wrote the row last: only that one may mark it gone, so a reconnect wins.
  stream String
  /// The stream closed. A tab reconnecting (every few minutes) clears it again.
  gone   Boolean  @default(false)
  seenAt DateTime @default(now()) @map("seen_at") @db.Timestamptz(3)

  @@index([seenAt])
  @@map("live_visitors")
}

/// One thing bought at the Ticket Booth's shop, paid for in tickets: a treat (eaten at the counter)
/// or a souvenir (kept, see Souvenir). What's for sale is apps/api/src/shop/catalog.ts.
model ShopOrder {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The catalog id, e.g. "cotton-candy".
  item         String
  ticketsSpent Int      @map("tickets_spent")
  /// The member's ticket balance right after paying.
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([item])
  @@map("shop_orders")
}

/// Each shop item's price and stock, edited in The Ringmaster's Office. An item without a row sells
/// at its catalog price (src/shop/catalog.ts) with no stock limit. Orders keep what they cost at the
/// time in shop_orders.tickets_spent.
model ShopItemSettings {
  /// The catalog id, e.g. "cotton-candy".
  item      String   @id
  /// The price, 1 to 1000 tickets (a CHECK constraint in the migration).
  tickets   Int
  /// How many are left to sell: each order takes one, and at 0 it's sold out. Null means no limit.
  /// Never negative (a CHECK constraint in the migration).
  stock     Int?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("shop_item_settings")
}

/// A souvenir a member owns: bought once, kept for good, and worn or not (one per slot).
model Souvenir {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The catalog id, e.g. "top-hat".
  item       String
  equipped   Boolean  @default(true)
  acquiredAt DateTime @default(now()) @map("acquired_at")

  @@id([userId, item])
  @@map("souvenirs")
}

/// What a suggestion is about, picked at the Idea Box.
enum SuggestionTopic {
  /// A new ride or game, or a change to one.
  attraction
  /// Treats and souvenirs at the Ticket Booth.
  shop
  /// The park itself: paths, benches, decorations, events.
  park
  /// Something broken or not working as it should.
  problem
  other

  @@map("suggestion_topic")
}

/// Where a suggestion stands, as staff set it in The Ringmaster's Office.
enum SuggestionStatus {
  /// Not answered yet.
  pending
  accepted
  in_development
  done
  declined

  @@map("suggestion_status")
}

/// An idea, request or problem left at the Idea Box by a member. Staff answer it once in The
/// Ringmaster's Office (reply) and move its status along as often as they like; the member sees
/// both at the Idea Box, and `unread` until they look.
model Suggestion {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  user            User             @relation("SuggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  topic           SuggestionTopic
  /// 1 to 500 characters (a CHECK constraint in the migration).
  message         String
  status          SuggestionStatus @default(pending)
  /// When staff last changed the status. Null while it is still pending from the start.
  statusChangedAt DateTime?        @map("status_changed_at")
  /// Staff's answer: written once, never edited (1 to 500 characters, a CHECK constraint).
  reply           String?
  repliedAt       DateTime?        @map("replied_at")
  /// Who answered. Set to null when that account is deleted; repliedByName still says who it was.
  repliedById     String?          @map("replied_by_id")
  repliedBy       User?            @relation("SuggestionReplier", fields: [repliedById], references: [id], onDelete: SetNull)
  repliedByName   String?          @map("replied_by_name")
  /// Staff answered or changed the status since the member last looked at their suggestions.
  unread          Boolean          @default(false)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("suggestions")
}

/// One Rally Trail run that crossed the line, timed for the daily leaderboard. A board runs from noon
/// to noon, Beirut time (src/trail/board-day.ts): each run is kept with the board day it counts for,
/// so a new board simply starts empty at 12:00 and the earlier ones stay, for the office. A player's
/// place on a board is their fastest run on it. The time is measured in the browser and checked
/// against how long its round lasted (src/trail/trail.service.ts).
model TrailRun {
  id           String    @id @default(cuid())
  /// The round it was driven in (one run per round).
  roundId      String    @unique @map("round_id")
  round        RideRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Start lights to the line, in milliseconds (positive: a CHECK constraint in the migration).
  timeMs       Int       @map("time_ms")
  /// The board it counts for: the date (Beirut) its noon-to-noon window started on.
  day          DateTime  @db.Date
  /// Taken off the board by staff, e.g. an impossible time. Kept, so it can be put back.
  disqualified Boolean   @default(false)
  /// When the run was handed in (it counts on the board open then).
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([day, timeMs])
  @@index([userId, day])
  @@index([createdAt])
  @@map("trail_runs")
}

/// What player-built coasters are made of, sold in the Coaster Workshop (src/workshop/design.ts says
/// what each is, its default price, and how much of each a design uses).
enum CoasterPart {
  /// 10 m of plain track (straights, curves, slopes, helices, and the way home to the station).
  steel
  /// 10 m of lift hill.
  lift
  /// 10 m of launch track.
  launch
  /// 10 m of brake run.
  brakes
  /// One vertical loop, steel included.
  loop
  /// One corkscrew roll, steel included.
  corkscrew
  station
  /// One car of a train.
  car

  @@map("coaster_part")
}

/// The coaster parts a member owns: bought in the Coaster Workshop, or from their free starter kit.
/// Saved designs hold them: what's free to build with is this, less what the member's designs use
/// (coaster_designs.parts).
model CoasterParts {
  userId   String      @map("user_id")
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  part     CoasterPart
  /// Never negative (a CHECK constraint in the migration).
  quantity Int

  @@id([userId, part])
  @@map("coaster_parts")
}

/// Each coaster part's price and stock in the Coaster Workshop, edited in The Ringmaster's Office. A
/// part without a row sells at its default price (src/workshop/design.ts) with no stock limit.
model CoasterPartSettings {
  part      CoasterPart @id
  /// Tickets per unit, 1 to 1000 (a CHECK constraint in the migration).
  tickets   Int
  /// Units left to sell; null means no limit. Never negative (a CHECK constraint).
  stock     Int?
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")

  @@map("coaster_part_settings")
}

/// Parts bought in the Coaster Workshop, paid for in tickets (the starter kit isn't an order).
model CoasterPartOrder {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  part         CoasterPart
  /// 1 to 50 units (a CHECK constraint in the migration).
  quantity     Int
  ticketsSpent Int         @map("tickets_spent")
  /// The member's ticket balance right after paying.
  balanceAfter Int         @map("balance_after")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("coaster_part_orders")
}

/// A coaster a member is building in the Coaster Workshop's Builder's Yard. A few are free, more
/// are bought (users.extra_design_slots). It holds the parts it uses while it's saved.
model CoasterDesign {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 to 24 characters (a CHECK constraint in the migration).
  name      String
  /// The design itself: pieces, colours, cars and ride mode, as cleanDesign (src/workshop/design.ts) left it.
  data      Json
  /// The parts it holds, by part (partsUsed in src/workshop/design.ts).
  parts     Json
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  creations Creation[]

  @@index([userId, updatedAt])
  @@map("coaster_designs")
}

/// Where a submitted coaster stands.
enum CreationStatus {
  /// Waiting for staff to look at it.
  pending
  /// Running on a plot in Creators' Valley.
  released
  /// Staff said no (with a reply). The design stays the member's to change and send again.
  declined
  /// Taken out of the park by staff.
  removed
  /// A newer version of the same design took its plot.
  replaced

  @@map("creation_status")
}

/// A coaster sent to staff from the Coaster Workshop: a snapshot of a design as it was then (the
/// member can carry on changing the design), with its numbers worked out here and a picture taken in
/// the game. Staff test-ride it, then release it onto a free plot of Creators' Valley or decline it
/// with a reply; a released coaster can be taken out again. The member sees where each stands, and
/// `unread` until they look. Its creator earns a royalty each time someone else rides it.
model Creation {
  id              String         @id @default(cuid())
  /// The design it was sent from (null once that's deleted; the snapshot stays).
  designId        String?        @map("design_id")
  design          CoasterDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)
  userId          String         @map("user_id")
  user            User           @relation("CreationCreator", fields: [userId], references: [id], onDelete: Cascade)
  /// 1 to 24 characters (a CHECK constraint in the migration).
  name            String
  /// The design as it was sent (src/workshop/design.ts).
  data            Json
  /// Its numbers, worked out on the server: length, height, top speed, G-forces, whether it makes it round.
  stats           Json
  /// A small picture of it, taken in the game (WebP or PNG, at most 120 kB).
  picture         Bytes?
  pictureType     String?        @map("picture_type")
  status          CreationStatus @default(pending)
  statusChangedAt DateTime?      @map("status_changed_at")
  /// The plot it stands on while released (1 to 8; one coaster per plot, a partial unique index), and
  /// where it stood once it's gone.
  plot            Int?
  /// Staff's answer when they declined it (1 to 500 characters, a CHECK constraint).
  reply           String?
  /// Who released or declined it. Set to null when that account is deleted; reviewedByName stays.
  reviewedById    String?        @map("reviewed_by_id")
  reviewedBy      User?          @relation("CreationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedByName  String?        @map("reviewed_by_name")
  releasedAt      DateTime?      @map("released_at")
  removedAt       DateTime?      @map("removed_at")
  /// Staff changed where it stands since the member last looked.
  unread          Boolean        @default(false)
  createdAt       DateTime       @default(now()) @map("created_at")
  rounds          RideRound[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([designId])
  @@index([createdAt])
  @@map("creations")
}
